@model CorporateSite.Domain.Common.PagedResult<CorporateSite.Domain.Entities.News>
@{ ViewData["Title"] = "最新消息管理"; }

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>最新消息管理</h2>
    <a asp-area="Admin" asp-controller="News" asp-action="Edit" class="btn btn-primary">＋ 新增</a>
</div>

<table class="table table-hover align-middle">
    <thead class="table-light">
        <tr>
            <th>標題</th>
            <th>分類</th>
            <th>狀態</th>
            <th>發佈時間</th>
            <th style="width:130px"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var n in Model.Items)
        {
            <tr>
                <td>@n.Title</td>
                <td>@n.Category</td>
                <td>
                    <span class="badge @(n.Status == CorporateSite.Domain.Enums.PublishStatus.Published
                        ? "bg-success" : "bg-warning text-dark")">
                        @n.Status
                    </span>
                </td>
                <td class="small text-muted">@n.PublishedAt?.ToString("yyyy-MM-dd")</td>
                <td>
                    <a asp-area="Admin" asp-controller="News" asp-action="Edit"
                       asp-route-id="@n.NewsId" class="btn btn-sm btn-outline-primary me-1">編輯</a>
                    <form asp-area="Admin" asp-controller="News" asp-action="Delete"
                          method="post" class="d-inline"
                          onsubmit="return confirm('確定要刪除「@n.Title」？')">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@n.NewsId" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">刪除</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPages > 1)
{
    <nav>
        <ul class="pagination">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-controller="News" asp-action="Index"
                       asp-route-page="@i">@i</a>
                </li>
            }
        </ul>
    </nav>
}
