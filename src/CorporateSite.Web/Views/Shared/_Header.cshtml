<!-- ===== Header：由美工維護此檔案與 wwwroot/css/site.css ===== -->
<header class="site-header bg-white border-bottom shadow-sm">
    <nav class="navbar navbar-expand-lg navbar-light container">
        <a class="navbar-brand" asp-controller="Home" asp-action="Index">
            <img src="~/images/logo.png" alt="企業 Logo" height="40"
                 onerror="this.style.display='none'" />
            <span class="fw-bold">企業官網</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav ms-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Home" asp-action="Index">首頁</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="News" asp-action="Index">最新消息</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="News" asp-action="Index" asp-route-category="ESG">ESG</a>
                </li>
            </ul>
            <!-- 登入/登出：認證功能待後續加入 -->
        </div>
    </nav>
</header>
