@model List<CorporateSite.Web.Models.NewsDto>
@{
    ViewData["Title"] = "最新消息";
}

<div class="container py-5">
    <h1 class="section-title mb-4">最新消息</h1>

    <div class="mb-4">
        <a asp-controller="News" asp-action="Index"
           class="btn btn-sm @(ViewBag.Category == null ? "btn-primary" : "btn-outline-secondary") me-1">
            <i class="fa fa-list me-1"></i>全部
        </a>
        <a asp-controller="News" asp-action="Index" asp-route-category="CompanyNews"
           class="btn btn-sm @(ViewBag.Category == "CompanyNews" ? "btn-primary" : "btn-outline-secondary") me-1">
            <i class="fa fa-building me-1"></i>公司新聞
        </a>
        <a asp-controller="News" asp-action="Index" asp-route-category="ESG"
           class="btn btn-sm @(ViewBag.Category == "ESG" ? "btn-primary" : "btn-outline-secondary") me-1">
            <i class="fa fa-leaf me-1"></i>ESG
        </a>
        <a asp-controller="News" asp-action="Index" asp-route-category="Announcement"
           class="btn btn-sm @(ViewBag.Category == "Announcement" ? "btn-primary" : "btn-outline-secondary")">
            <i class="fa fa-bullhorn me-1"></i>公告
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="fa fa-inbox fa-3x text-muted mb-3 d-block"></i>
            <p class="text-muted">目前尚無公開消息。</p>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card news-card h-100">
                        <div class="card-body">
                            <span class="badge bg-primary mb-2">@item.Category</span>
                            <h5 class="card-title">
                                <a asp-controller="News" asp-action="Details" asp-route-id="@item.NewsId"
                                   class="text-decoration-none text-dark stretched-link">@item.Title</a>
                            </h5>
                            @if (!string.IsNullOrWhiteSpace(item.Summary))
                            {
                                <p class="card-text text-muted small">@item.Summary</p>
                            }
                        </div>
                        <div class="card-footer">
                            <i class="fa fa-calendar-o me-1"></i>
                            @item.PublishedAt?.ToString("yyyy-MM-dd")
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
